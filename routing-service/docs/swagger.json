{
    "swagger": "2.0",
    "info": {
        "description": "API para obtener rutas optimizadas de limpieza por zona",
        "title": "Routing Service API",
        "contact": {},
        "version": "1.0"
    },
    "host": "localhost:8086",
    "basePath": "/",
    "paths": {
        "/api/v1/routes": {
            "get": {
                "description": "Retorna todas las rutas optimizadas agrupadas por zona",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Routes"
                ],
                "summary": "Lista todas las rutas optimizadas",
                "responses": {
                    "200": {
                        "description": "Rutas optimizadas agrupadas por zona",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    },
                    "500": {
                        "description": "Error interno del servidor",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        },
        "/api/v1/routes/zone/{zone_id}": {
            "get": {
                "description": "Retorna la última ruta optimizada para una zona específica con las coordenadas de los puntos",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Routes"
                ],
                "summary": "Obtiene la ruta optimizada por zona",
                "parameters": [
                    {
                        "type": "integer",
                        "description": "ID de la zona",
                        "name": "zone_id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Ruta optimizada con coordenadas",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    },
                    "400": {
                        "description": "ID de zona inválido",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    },
                    "404": {
                        "description": "No se encontró ruta para esta zona",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    },
                    "500": {
                        "description": "Error interno del servidor",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        },
        "/health": {
            "get": {
                "description": "Verifica el estado del servicio de routing",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Health"
                ],
                "summary": "Health check del servicio",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        }
    }
}