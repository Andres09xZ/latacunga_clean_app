{
    "swagger": "2.0",
    "info": {
        "description": "API para validación manual de incidentes por administradores (con BD propia)",
        "title": "Validation Service API",
        "contact": {},
        "version": "1.0"
    },
    "host": "localhost:8082",
    "basePath": "/",
    "paths": {
        "/api/v1/incidents/pending": {
            "get": {
                "description": "Obtiene todos los incidentes con estado 'pendiente_validacion' de la BD local",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Validation"
                ],
                "summary": "Listar incidentes pendientes",
                "responses": {
                    "200": {
                        "description": "Lista de incidentes pendientes",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    },
                    "500": {
                        "description": "Error al obtener incidentes",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        },
        "/api/v1/incidents/{id}/validate": {
            "post": {
                "description": "Valida o rechaza un incidente manualmente (solo administradores)",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Validation"
                ],
                "summary": "Validar incidente",
                "parameters": [
                    {
                        "type": "string",
                        "description": "ID del incidente",
                        "name": "id",
                        "in": "path",
                        "required": true
                    },
                    {
                        "description": "Estado de validación",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/main.ValidateRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Incidente validado exitosamente",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    },
                    "400": {
                        "description": "Solicitud inválida",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    },
                    "404": {
                        "description": "Incidente no encontrado",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    },
                    "500": {
                        "description": "Error al validar",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        },
        "/health": {
            "get": {
                "description": "Verifica el estado del servicio y la base de datos",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Health"
                ],
                "summary": "Health check",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "main.ValidateRequest": {
            "type": "object",
            "required": [
                "status"
            ],
            "properties": {
                "notes": {
                    "type": "string",
                    "example": "Incidente verificado por administrador"
                },
                "status": {
                    "description": "incidente_valido o incidente_rechazado",
                    "type": "string",
                    "example": "incidente_valido"
                }
            }
        }
    }
}